/* pages/compare/compare.wxss */
.ph {
  padding: 48rpx 24rpx;
}
.ph-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.ph-desc {
  font-size: 26rpx;
  color: #86909c;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.ph-btn {
  border-radius: 12rpx;
  margin: 16rpx 0;
}
.ph-btn-ghost {
  background: #fff;
  color: #165dff;
  border: 1rpx solid #165dff;
}
