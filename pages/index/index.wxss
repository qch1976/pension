/* pages/index/index.wxss */
/* Bug25：section ④ 内分项小标题（个人账户储蓄额 / 人员身份与R补） */
.subhead {
  font-weight: 600;
  font-size: 27rpx;
  color: #1f2329;
  margin: 20rpx 0 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.subhead:first-of-type {
  border-top: none;
  padding-top: 4rpx;
}
.hero {
  padding: 32rpx 40rpx 8rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.opt {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin: 6rpx 6rpx;
  border: 1rpx solid #c9cdd4;
  border-radius: 999rpx;
  color: #4e5969;
  font-size: 26rpx;
}
.opt-on {
  background: #165dff;
  border-color: #165dff;
  color: #fff;
}
.seg {
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin: 16rpx 0;
  background: #fafbfc;
}
.seg-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.del {
  margin-left: auto;
  color: #c02a26;
  font-size: 24rpx;
  padding: 8rpx;
}
.mini-btn {
  background: #fff;
  border: 1rpx dashed #165dff;
  color: #165dff;
  font-size: 26rpx;
  border-radius: 10rpx;
  margin-top: 16rpx;
}
.ta {
  width: 100%;
  min-height: 140rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}
