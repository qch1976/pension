<!-- pages/entry/entry.wxml -->
<view class="entry">
  <view class="entry-head">
    <view class="entry-title">北京市企业职工养老金测算</view>
    <view class="entry-sub">请选择测算方式</view>
  </view>

  <!-- 基本计算入口（REQ-01-OPT-000） -->
  <view class="entry-card" hover-class="entry-card-hover" bindtap="goBasic">
    <view class="entry-icon entry-icon-basic">①</view>
    <view class="entry-body">
      <view class="entry-name">基本计算</view>
      <view class="entry-desc">单方案养老金测算，录入信息后一次得出月养老金</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>

  <!-- 方案比较入口（REQ-01-OPT-000） -->
  <view class="entry-card" hover-class="entry-card-hover" bindtap="goCompare">
    <view class="entry-icon entry-icon-cmp">②</view>
    <view class="entry-body">
      <view class="entry-name">方案比较</view>
      <view class="entry-desc">最多 3 个方案对比 P月、R续、回本月数与 ROI</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>
</view>
