/* pages/entry/entry.wxss */
.entry {
  padding: 24rpx 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.entry-head {
  padding: 48rpx 40rpx 24rpx;
}
.entry-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
}
.entry-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #86909c;
}
.entry-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.05s ease;
}
.entry-card-hover {
  background: #f7f8fa;
  transform: scale(0.99);
}
.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.entry-icon-basic {
  background: #e8f0ff;
  color: #165dff;
}
.entry-icon-cmp {
  background: #e8f8ee;
  color: #0a7f2e;
}
.entry-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.entry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.entry-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.5;
}
.entry-arrow {
  font-size: 44rpx;
  color: #c9cdd4;
  margin-left: 12rpx;
  flex-shrink: 0;
}
