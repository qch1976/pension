/* components/plan-list/plan-list.wxss */
.plan-list-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  padding: 16rpx 24rpx 0;
}
.plan-add {
  background: #fff;
  border: 1rpx dashed #165dff;
  color: #165dff;
  font-size: 26rpx;
  border-radius: 12rpx;
  margin: 20rpx 24rpx 8rpx;
}
.plan-add-disabled {
  border-color: #c9cdd4;
  color: #c9cdd4;
}
