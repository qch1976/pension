# ============================================================
# pension .gitignore (backup / log / run-output excluded)
# ============================================================

# ---- backup snapshots (all levels) ----
backup/
backup-*/
docs/backup/

# ---- logs / run results ----
*.log
*.err
*.exit
_sess0-*.log
autotest/**/logs/
autotest/output/
autotest/gui/job.txt
autotest/gui/job-result.json
tests/round1-fixes-output.txt
tests/test-results-*.json

# ---- dependencies ----
node_modules/

# ---- OS / editor ----
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.bak
.vscode/
.idea/

# ---- PensionGuiRun runtime state (per-delivery, never commit) ----
system_test/utils/job.txt
system_test/utils/job-result.json
